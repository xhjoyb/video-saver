<?xml version="1.0" encoding="utf-8"?>
<!-- 启动页居中 Logo：青绿渐变圆 + 外环 + 播放三角 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 外环光晕 -->
    <path
        android:pathData="M54,54 m-39,0 a39,39 0 1,0 78,0 a39,39 0 1,0 -78,0"
        android:fillColor="#00000000"
        android:strokeColor="#2619E8BE"
        android:strokeWidth="1.2" />
    <!-- 主体：青绿渐变圆 -->
    <path android:pathData="M54,54 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="28"
                android:endX="78"
                android:endY="82">
                <item android:offset="0" android:color="#FF6BFFDD" />
                <item android:offset="0.5" android:color="#FF19E8BE" />
                <item android:offset="1" android:color="#FF00A98A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 播放三角 -->
    <path
        android:fillColor="#FF04120F"
        android:pathData="M45,40 L73,54 L45,68 Z" />
</vector>