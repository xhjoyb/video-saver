<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 启动图标底稿：青绿圆 + 播放三角 + 可旋转的双弧 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 旋转组：两段错位弧，形成扫描感 -->
    <group
        android:name="spinner"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:pathData="M54,13 A41,41 0 0 1 95,54"
            android:fillColor="#00000000"
            android:strokeColor="#FF6BFFDD"
            android:strokeLineCap="round"
            android:strokeWidth="5" />
        <path
            android:pathData="M54,95 A41,41 0 0 1 13,54"
            android:fillColor="#00000000"
            android:strokeColor="#6619E8BE"
            android:strokeLineCap="round"
            android:strokeWidth="3.5" />
    </group>
    <!-- 主体：青绿渐变圆 -->
    <path android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38"
                android:startY="32"
                android:endX="76"
                android:endY="80">
                <item android:offset="0" android:color="#FF6BFFDD" />
                <item android:offset="0.5" android:color="#FF19E8BE" />
                <item android:offset="1" android:color="#FF00A98A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 播放三角 -->
    <path
        android:fillColor="#FF04120F"
        android:pathData="M45,40 L73,54 L45,68 Z" />
</vector>