<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 系统 SplashScreen：青绿底 + 旋转弧线动画，衔接 Flutter 侧开屏动画 -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_anim</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>